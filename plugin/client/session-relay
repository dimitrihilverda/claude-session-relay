#!/usr/bin/env bash
# Thin wrapper: all logic lives in session-relay.ps1.
# Git Bash (MSYS) would rewrite arguments like "/sessie klaar" into Windows paths.
export MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*'
dir="$(cd "$(dirname "$0")" && pwd)"
script="$dir/session-relay.ps1"
if command -v cygpath >/dev/null 2>&1; then
	script="$(cygpath -w "$script")"
fi
if command -v pwsh >/dev/null 2>&1; then
	exec pwsh -NoProfile -File "$script" "$@"
fi
exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$script" "$@"
