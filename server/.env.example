RELAY_DB_PASS=change-me
RELAY_PORT=8080
# Public HTTPS address of the relay, needed for the claude.ai connector (MCP/OAuth).
RELAY_PUBLIC_URL=https://relay.example.com
# Optional: comma-separated exact https:// OAuth redirect URIs for a trusted service (no query, fragment or wildcard).
RELAY_OAUTH_EXTRA_REDIRECTS=
